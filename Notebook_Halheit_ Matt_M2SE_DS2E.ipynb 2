        "import torch.nn as nn\n",
        "import timm\n",
        "\n",
        "# --- Cellule 3 : Définition du Modèle SOTA ---\n",
        "\n",
        "class EuroSAT_Swin_Model(nn.Module):\n",
        "    def __init__(self, num_classes, in_channels=13):\n",
        "        super().__init__()\n",
        "        print(f\"🏗️ Chargement du backbone Swin Transformer...\")\n",
        "\n",
        "        # 1. Chargement du modèle pré-entraîné (Swin Tiny)\n",
        "        self.backbone = timm.create_model('swin_tiny_patch4_window7_224', pretrained=True, num_classes=0)\n",
        "\n",
        "        # 2. Adaptation de la première couche pour 13 canaux (au lieu de 3 RGB)\n",
        "        original_proj = self.backbone.patch_embed.proj\n",
        "\n",
        "        new_proj = nn.Conv2d(\n",
        "            in_channels,\n",
        "            original_proj.out_channels,\n",
        "            kernel_size=original_proj.kernel_size,\n",
        "            stride=original_proj.stride,\n",
        "            padding=original_proj.padding\n",
        "        )\n",
        "\n",
        "        # 3. Initialisation intelligente des poids\n",
        "        # On copie les poids RGB (canaux 0,1,2) et on fait la moyenne pour les autres\n",
        "        with torch.no_grad():\n",
        "            new_proj.weight[:, :3] = original_proj.weight\n",
        "            mean_weight = torch.mean(original_proj.weight, dim=1, keepdim=True)\n",
        "            # On répète la moyenne pour les 10 canaux restants\n",
        "            new_proj.weight[:, 3:] = mean_weight.repeat(1, in_channels - 3, 1, 1)\n",
        "\n",
        "            if new_proj.bias is not None:\n",
        "                new_proj.bias = original_proj.bias\n",
        "\n",
        "        # Remplacement de la couche dans le modèle\n",
        "        self.backbone.patch_embed.proj = new_proj\n",
        "\n",
        "        # 4. Tête de classification finale\n",
        "        self.head = nn.Linear(self.backbone.num_features, num_classes)\n",
        "\n",
        "    def forward(self, x):\n",
        "        # Interpolation : On passe de 64x64 (EuroSAT) à 224x224 (Attendu par Swin)\n",
        "        x = torch.nn.functional.interpolate(x, size=(224, 224), mode='bicubic', align_corners=False)\n",
        "        features = self.backbone(x)\n",
        "        return self.head(features)\n",
        "\n",
        "# Initialisation du modèle\n",
