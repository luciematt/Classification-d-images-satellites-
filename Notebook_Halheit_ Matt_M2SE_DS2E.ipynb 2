        "# --- Cellule 4 : Entraînement ---\n",
        "\n",
        "# Hyperparamètres\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "# Learning rate faible car on fait du fine-tuning\n",
        "optimizer = optim.AdamW(model.parameters(), lr=5e-5, weight_decay=0.01)\n",
