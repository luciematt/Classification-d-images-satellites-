        "print(f\"📍 Dossier des images : {data_root}\")\n",
        "\n",
        "# 2. Définition de la Classe Dataset\n",
        "class EuroSAT13Bands(Dataset):\n",
        "    def __init__(self, image_paths, class_to_idx, transform=None):\n",
        "        self.image_paths = image_paths\n",
        "        self.class_to_idx = class_to_idx\n",
        "        self.transform = transform\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.image_paths)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        path = self.image_paths[idx]\n",
        "        with rasterio.open(path) as src:\n",
        "            image = src.read().astype(np.float32) # Lecture des 13 canaux\n",
        "\n",
        "        # Normalisation (0-1)\n",
        "        image = image / 10000.0\n",
        "        image = np.clip(image, 0, 1)\n",
        "\n",
        "        image = torch.from_numpy(image)\n",
        "\n",
        "        label_name = os.path.basename(os.path.dirname(path))\n",
        "        label = self.class_to_idx[label_name]\n",
        "\n",
        "        if self.transform:\n",
        "            image = self.transform(image)\n",
        "        return image, label\n",
        "\n",
        "# 3. Création de la liste des classes (C'est ICI que 'classes' est définie !)\n",
        "classes = sorted([d for d in os.listdir(data_root) if os.path.isdir(os.path.join(data_root, d))])\n",
        "class_to_idx = {cls_name: i for i, cls_name in enumerate(classes)}\n",
        "print(f\"🏷️ {len(classes)} Classes trouvées : {classes}\")\n",
        "\n",
        "# 4. Récupération des chemins d'images\n",
        "all_paths = []\n",
        "all_labels = []\n",
        "for cls in classes:\n",
        "    cls_folder = os.path.join(data_root, cls)\n",
        "    paths = glob.glob(os.path.join(cls_folder, \"*.tif\"))\n",
        "    all_paths.extend(paths)\n",
        "    all_labels.extend([class_to_idx[cls]] * len(paths))\n",
        "\n",
        "# 5. Splits (Train/Val/Test)\n",
        "train_paths, test_paths, train_labels, _ = train_test_split(\n",
